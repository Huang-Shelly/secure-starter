# 複製成 .env 後填入（.env 已在 .gitignore，絕不提交）
# 正式環境請改用雲端 Secret Manager（GCP Secret Manager / AWS Secrets Manager / Vercel/Fly secrets）注入

# PostgreSQL 連線字串（使用最小權限的資料庫帳號）
DATABASE_URL=postgresql://app:change-me@localhost:5432/app

# 網站對外來源（正式環境必須是 https）
APP_ORIGIN=http://localhost:3000

# WebAuthn / Passkey
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Secure Starter

# Session（分鐘 / 小時）
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# 前面有幾層可信任的反向代理（Load Balancer / CDN）；0 = 不信任 X-Forwarded-For
TRUSTED_PROXY_HOPS=0

# AI Agent（選用；未設定時 /api/agent 回 503）
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5

# 只在 DAST / 模糊測試環境使用，正式環境必須是 1
RATE_LIMIT_SCALE=1
